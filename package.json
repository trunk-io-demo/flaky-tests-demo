{
  "name": "flaky-tests-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A demo and regression surface for Trunk's flaky-test monitors.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm --recursive --if-present --no-bail test",
    "test:e2e": "pnpm --recursive --if-present --no-bail test:e2e",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "trunk check --all",
    "lint:fix": "trunk check --all --fix",
    "format": "trunk fmt --all",
    "format:fix": "trunk fmt --all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
